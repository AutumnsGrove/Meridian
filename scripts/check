#!/usr/bin/env bash
# The one gate, shared by hands and CI (docs/STANDARDS.md section 8).
#
# Run this once per clone so the pre-commit hook is installed:
#     git config core.hooksPath .githooks
#
# Usage: scripts/check [go|web|e2e|fuzz|security|all] [--fast]
set -euo pipefail

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
cd "$script_dir/.."

read -r -d '' usage <<'EOF' || true
usage: scripts/check [group] [--fast]

groups:
  go        gofmt, go vet, golangci-lint, go test, go build
  web       frozen install, svelte-check, eslint, prettier, vitest, build
  e2e       build the web app and the binary, then run Playwright
  fuzz      every Fuzz* target for $FUZZ_TIME (default 5s; CI passes 20s)
  security  govulncheck, gitleaks, pnpm audit, actionlint, shellcheck
  all       every group above (the default)

flags:
  --fast    skip the slow jobs: no -race, no web build, no e2e, no fuzz,
            no security. This is what the pre-commit hook runs.

Set the hooks up once per clone: git config core.hooksPath .githooks
EOF

# The script checks its own CLI contract before it runs anything: `check help` must exit 0 and
# name every group, because a gate that silently skips a group is worse than no gate.
self_check() {
	local help_output
	if ! help_output=$(CHECK_SELF=1 "$script_dir/check" help); then
		printf 'check: self-check failed: "check help" exited non-zero\n' >&2
		exit 1
	fi
	local group
	for group in go web e2e fuzz security; do
		case "$help_output" in
		*"$group"*) ;;
		*)
			printf 'check: self-check failed: help does not list the %s group\n' "$group" >&2
			exit 1
			;;
		esac
	done
}

[ "${CHECK_SELF:-}" = 1 ] || self_check

group=all
fast=0

while [ $# -gt 0 ]; do
	case "$1" in
	go | web | e2e | fuzz | security | all) group=$1 ;;
	--fast) fast=1 ;;
	help | -h | --help)
		printf '%s\n' "$usage"
		exit 0
		;;
	*)
		printf 'check: unknown argument %q\n\n%s\n' "$1" "$usage" >&2
		exit 2
		;;
	esac
	shift
done

# need <tool> <install hint>
# A missing tool is an error with a hint, never a silent skip.
need() {
	if command -v "$1" >/dev/null 2>&1; then
		return 0
	fi
	printf 'check: %s not found. Install it with: %s\n' "$1" "$2" >&2
	exit 1
}

check_go() {
	printf '== go\n'
	local unformatted
	unformatted=$(find . -type f -name '*.go' \
		-not -path './.git/*' -not -path './web/node_modules/*' -not -path './web/build/*' \
		-exec gofmt -l {} +)
	if [ -n "$unformatted" ]; then
		printf 'gofmt: these files need formatting:\n%s\n' "$unformatted" >&2
		exit 1
	fi
	need golangci-lint 'https://golangci-lint.run/usage/install/'
	go vet ./...
	golangci-lint run
	if [ "$fast" = 1 ]; then
		go test -shuffle=on ./...
	else
		go test -race -shuffle=on ./...
	fi
	go build ./cmd/...
}

check_web() {
	if [ ! -f web/package.json ]; then
		printf '== web: skipped (web/package.json does not exist yet)\n'
		return 0
	fi
	printf '== web\n'
	need pnpm 'npm install --global pnpm'
	(
		cd web
		pnpm install --frozen-lockfile
		pnpm check
		pnpm lint
		pnpm format:check
		pnpm test
	)
	if [ "$fast" = 0 ]; then
		(cd web && pnpm build)
	fi
}

check_e2e() {
	if [ "$fast" = 1 ]; then
		printf '== e2e: skipped (--fast)\n'
		return 0
	fi
	if [ ! -f web/playwright.config.ts ]; then
		printf '== e2e: skipped (no Playwright config yet)\n'
		return 0
	fi
	printf '== e2e\n'
	need pnpm 'npm install --global pnpm'
	(cd web && pnpm install --frozen-lockfile && pnpm build)
	mkdir -p dist
	go build -o dist/meridian ./cmd/meridian
	(cd web && pnpm exec playwright test)
}

# check_fuzz runs every target for real. The corpus is already part of `go test`; this is the part
# that finds new failures, and it is probabilistic: a clean run here does not promise a clean CI run,
# only a shorter one. scripts/check --fast skips it, so a commit stays quick.
check_fuzz() {
	if [ "$fast" = 1 ]; then
		printf '== fuzz: skipped (--fast)\n'
		return 0
	fi
	local duration=${FUZZ_TIME:-5s}
	printf '== fuzz (every target for %s)\n' "$duration"
	"$script_dir/fuzz" "$duration"
}

check_security() {
	if [ "$fast" = 1 ]; then
		printf '== security: skipped (--fast)\n'
		return 0
	fi
	printf '== security\n'
	need govulncheck 'go install golang.org/x/vuln/cmd/govulncheck@latest'
	govulncheck ./...

	need gitleaks 'brew install gitleaks'
	gitleaks detect --source . --redact --no-banner

	if [ -f web/package.json ]; then
		need pnpm 'npm install --global pnpm'
		(cd web && pnpm audit --prod)
	fi

	need actionlint 'go install github.com/rhysd/actionlint/cmd/actionlint@latest'
	if [ -d .github/workflows ]; then
		actionlint
	else
		printf 'actionlint: skipped (no .github/workflows yet)\n'
	fi

	need shellcheck 'brew install shellcheck'
	find scripts -maxdepth 1 -type f -exec shellcheck {} +
	if [ -d deploy ]; then
		find deploy -type f -name '*.sh' -exec shellcheck {} +
	fi
}

case "$group" in
all)
	check_go
	check_fuzz
	check_web
	check_e2e
	check_security
	;;
go) check_go ;;
web) check_web ;;
e2e) check_e2e ;;
fuzz) check_fuzz ;;
security) check_security ;;
esac

printf 'check: ok\n'
