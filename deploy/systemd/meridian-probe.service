# The host probe: one oneshot per timer tick, writing the snapshot the dashboard reads.
#
# It runs as the deploy user, never root. `systemctl show` and `tailscale status` do not need root, and
# the host binary must not be a second way to act as root on this box (decision #27).
#
# @DEPLOY_USER@ and @STATUS_DIR@ are filled by the installer (T31/T36). STATUS_DIR is the Meridian
# data directory on the host, the same one the container mounts read-only at /status.
[Unit]
Description=Meridian host probe (write the dashboard's host snapshot)
Documentation=https://github.com/autumnsgrove/meridian/blob/main/docs/ARCHITECTURE.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=@DEPLOY_USER@
ExecStart=/etc/meridian/meridian-host probe --out @STATUS_DIR@/host.json

# The probe only ever writes host.json, and it reads nothing outside /proc, /run and /etc/meridian.
# ProtectHome is read-only rather than yes: the status directory lives under the deploy user's home on
# the box this ships to, and `ProtectHome=yes` makes all of /home inaccessible, which ReadWritePaths
# cannot undo. The first real install failed exactly that way.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@STATUS_DIR@
