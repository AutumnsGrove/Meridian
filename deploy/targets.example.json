{
  "targets": {
    "worker": {
      "kind": "systemd",
      "unit": "worker.service",
      "actions": ["start", "stop", "restart", "update"],
      "criticality": "medium",
      "update": { "kind": "unit", "unit": "worker-update.service" }
    },
    "resolver": {
      "kind": "systemd",
      "unit": "resolver.service",
      "actions": ["start", "stop", "restart"],
      "dns": true,
      "criticality": "high",
      "no_update_reason": "this server has no scripted updater"
    },
    "app": {
      "kind": "compose",
      "dir": "/srv/app",
      "service": "app",
      "actions": ["start", "stop", "restart", "update"],
      "criticality": "medium",
      "update": { "kind": "docker" }
    },
    "sidecar": {
      "kind": "container",
      "container": "sidecar",
      "actions": ["start", "stop", "restart"],
      "criticality": "low"
    },
    "meridian": {
      "kind": "systemd",
      "unit": "meridian.service",
      "actions": ["start", "stop", "restart", "update"],
      "criticality": "high",
      "result_first": true,
      "update": {
        "kind": "self",
        "image": "ghcr.io/owner/meridian",
        "dir": "/srv/meridian",
        "service": "meridian",
        "port": 8891,
        "signal_file": "/srv/meridian/update-signal/requested"
      }
    },
    "host": {
      "kind": "host",
      "actions": ["reboot"],
      "criticality": "high"
    }
  }
}
