# Copy to .env next to docker-compose.yml on the box and fill in. Never commit .env: it holds the
# image digest and, later, the credentials the config references by name.
#
# The three names below are the ones deploy/docker-compose.yml reads. Anything else the config needs
# arrives here too, by the variable names config.yaml uses, never as values in the repo.

# The image, pinned by digest. Phase 4's self-update rewrites this line when it adopts a new build.
MERIDIAN_IMAGE=

# The deploy user's ids (id -u, id -g), so the container writes files as the owner of ~/Meridian.
MERIDIAN_UID=
MERIDIAN_GID=
